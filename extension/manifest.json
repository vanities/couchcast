{
  "manifest_version": 3,
  "name": "Couchcast",
  "version": "0.1.0",
  "description": "Send the YouTube video you're watching to the YouTube app on your TV with one click. Links with a TV code, no extra app needed.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_title": "Cast to TV",
    "default_icon": "icons/icon.svg"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "contextMenus", "notifications", "scripting", "storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+Y" },
      "description": "Cast the current video to your TV"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "couchcast@vanities",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
